.venv/
venv_backup/
__pycache__/
*.pyc
.pytest_cache/
.env
.env.local
.idea/
.vscode/
.claude/
*.log
data/raw/
data/processed/
ex*.py

# Locust: so o resumo (_stats.csv) e evidencia; o resto se regenera.
load/results/**/*_stats_history.csv
load/results/**/*_exceptions.csv
load/results/**/*_failures.csv
# O protocolo da §3.3 guarda tudo: falhas segregadas por codigo HTTP e a serie
# temporal (rampa incluida) sao resultado, nao ruido.
!load/results/protocolo/*_stats_history.csv
!load/results/protocolo/*_failures.csv
!load/results/protocolo/*.log
!load/results/protocolo*/**/*_stats_history.csv
!load/results/protocolo*/**/*_failures.csv
!load/results/protocolo*/**/*.log
# stderr bruto da API: um traceback por timeout (351 MB na 1a execucao). Resumo versionado.
load/results/protocolo*/**/execucao-erros.log
load/results/s8-pool-*/**/execucao-erros.log
