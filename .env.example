APP_ENV=development
DEBUG=true
# Log de cada SQL; nunca ligado durante medicao de carga
SQL_ECHO=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/olist
# Cache de resposta SDUI (ligado por padrao; exige `docker compose up -d redis`)
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
